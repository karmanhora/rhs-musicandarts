{
  "name": "rhs-band-attendance",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check:headers": "node scripts/dev/check_security_headers.mjs",
    "test:e2e": "playwright test",
    "test:qa": "playwright test --project=chromium"
  },
  "//browserslist": "The support floor this app is built, styled and tested against. browserslist drives the CSS/JS lowering tools; docs/BROWSER_SUPPORT.md states the honest minimum for each feature, which is sometimes *higher* than this list — see there before adding one.",
  "browserslist": [
    "last 2 chrome versions",
    "last 2 edge versions",
    "last 2 firefox versions",
    "last 2 safari versions",
    "iOS >= 15.4",
    "ChromeAndroid >= 100",
    "SamsungInternet >= 16",
    "not dead"
  ],
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@supabase/supabase-js": "^2.112.3",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.31.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "vgpu": "^0.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vgpu/wgsl": "^0.6.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@webgpu/types": "^0.1.74",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
