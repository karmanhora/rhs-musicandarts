# iOS release / TestFlight environment.
# Copy to `.env.ios.local` before `npm run cap:sync`; that file is gitignored.
#
# These are the hosted Supabase values, not the local `.env.local` stack.
# Building with the local URL would make every sign-in and query hit a server
# that is not part of the app, which is what the iOS build guard prevents.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Do not set VITE_NATIVE_GOOGLE_SIGNIN here. The App Store build deliberately
# offers email/password only, so it does not trigger guideline 4.8.
#
# For Google in the local simulator, copy `.env.ios-dev.example` to
# `.env.ios-dev.local` and use `npm run cap:sync:dev`.
