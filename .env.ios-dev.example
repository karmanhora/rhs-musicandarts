# Local iOS simulator / development environment.
# Copy to `.env.ios-dev.local`; that file is gitignored.
#
# The same hosted Supabase project as `.env.ios.local` so the simulator tests
# the real accounts and data. Google is enabled here only because this build is
# for local development and is never uploaded to App Store Connect.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
VITE_NATIVE_GOOGLE_SIGNIN=true
